  // Update all elements with data-i18n
  document.querySelectorAll('[data-i18n]').forEach(function(el) {
    var key = el.getAttribute('data-i18n');
    if (translations[key] && translations[key][lang]) {
      el.textContent = translations[key][lang];
    }
  });

  // Show/hide lang selector based on language
  var sel = document.getElementById('lang-switcher');
  if (lang === 'zh') {
    sel.style.display = 'none';
  } else {
    sel.style.display = 'inline-block';
  }
}

// Show language switcher on hover of nav
// FAQ Accordion functionality
document.addEventListener('DOMContentLoaded', function() {
  switchLanguage('zh');
  
  // FAQ Toggle functionality
  const faqToggles = document.querySelectorAll('.faq-toggle');
  faqToggles.forEach(toggle => {
    toggle.addEventListener('click', function() {
      const faqItem = this.closest('.faq-item');
      const content = faqItem.querySelector('.faq-content');
      const icon = this.querySelector('svg');
      
      // Toggle visibility
      content.classList.toggle('hidden');
      
      // Rotate icon if open
      if (!content.classList.contains('hidden')) {
        icon.style.transform = 'rotate(180deg)';
        content.style.animation = 'accordionDown 0.2s ease-out';
      } else {
        icon.style.transform = 'rotate(0deg)';
      }
    });
  });
  
  // Add accordion animation styles
  const style = document.createElement('style');
  style.textContent = `
    @keyframes accordionDown {
      0% { max-height: 0; opacity: 0; }
      100% { max-height: 500px; opacity: 1; }
    }
  `;
  document.head.appendChild(style);
});
</script>
</body>
